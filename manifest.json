{
  "manifest_version": 3,
  "name": "Tab Vault",
  "short_name": "Tab Vault",
  "version": "1.0.0",
  "description": "Save and organize open tabs in local storage to reopen later.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save all tabs in this window to Tab Vault"
    }
  }
}
